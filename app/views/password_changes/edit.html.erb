<div class="w-full max-w-md mx-auto animate-fade-in py-6">
  <div class="card bg-base-100 border border-base-300 shadow-xl">
    <div class="card-body gap-6 p-6 sm:p-10">
      <div class="text-center space-y-2">
        <div class="text-4xl">🔑</div>
        <h1 class="text-2xl font-black tracking-tight"><%= t("password_changes.edit.title") %></h1>
        <p class="text-sm opacity-60"><%= t("password_changes.edit.subtitle") %></p>
      </div>

      <% if @user.errors.any? %>
        <div role="alert" class="alert alert-error shadow-sm p-4">
          <div class="flex flex-col gap-1">
            <span class="font-bold text-sm"><%= t("password_changes.edit.errors_title") %></span>
            <ul class="list-disc list-inside text-xs space-y-0.5">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <%= form_with model: @user, url: password_change_path, method: :patch, class: "space-y-4" do |form| %>
        <div class="form-control">
          <%= form.label :current_password, t("password_changes.edit.current_password"), class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
          <%= form.password_field :current_password, required: true, autocomplete: "current-password", placeholder: "••••••••", class: "input input-bordered w-full focus:input-primary transition-all duration-200" %>
        </div>

        <div class="form-control">
          <%= form.label :password, t("password_changes.edit.new_password"), class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••", class: "input input-bordered w-full focus:input-primary transition-all duration-200" %>
          <label class="label py-1">
            <span class="label-text-alt opacity-50 text-[11px]"><%= t("password_changes.edit.password_hint") %></span>
          </label>
        </div>

        <div class="form-control">
          <%= form.label :password_confirmation, t("password_changes.edit.password_confirmation"), class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "••••••••", class: "input input-bordered w-full focus:input-primary transition-all duration-200" %>
        </div>

        <div class="form-control pt-2 space-y-2">
          <%= form.submit t("password_changes.edit.submit_button"), class: "btn btn-primary w-full shadow-md shadow-primary/20 font-bold" %>
          <%= link_to t("password_changes.edit.cancel_button"), root_path, class: "btn btn-ghost btn-sm w-full font-semibold" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
