<div class="w-full max-w-md mx-auto animate-fade-in py-6">
  <div class="card bg-base-100 border border-base-300 shadow-xl">
    <div class="card-body gap-6 p-6 sm:p-10">
      <div class="text-center space-y-2">
        <div class="text-4xl">🛡️</div>
        <h1 class="text-2xl font-black tracking-tight">Đặt mật khẩu mới</h1>
        <p class="text-sm opacity-60">Tạo một mật khẩu mới an toàn để bảo vệ tài khoản của bạn.</p>
      </div>

      <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
        <div class="form-control">
          <%= form.label :password, "Mật khẩu mới", class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Nhập mật khẩu mới", maxlength: 72, class: "input input-bordered w-full focus:input-primary transition-all duration-200" %>
        </div>

        <div class="form-control">
          <%= form.label :password_confirmation, "Xác nhận mật khẩu mới", class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Nhập lại mật khẩu mới", maxlength: 72, class: "input input-bordered w-full focus:input-primary transition-all duration-200" %>
        </div>

        <div class="form-control pt-2">
          <%= form.submit "Lưu mật khẩu", class: "btn btn-primary w-full shadow-md shadow-primary/20 font-bold" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
