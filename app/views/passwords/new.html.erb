<div class="w-full max-w-md mx-auto animate-fade-in py-6">
  <div class="card bg-base-100 border border-base-300 shadow-xl">
    <div class="card-body gap-6 p-6 sm:p-10">
      <div class="text-center space-y-2">
        <div class="text-4xl">🔑</div>
        <h1 class="text-2xl font-black tracking-tight"><%= t("passwords.new.title") %></h1>
        <p class="text-sm opacity-60"><%= t("passwords.new.subtitle") %></p>
      </div>

      <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
        <div class="form-control">
          <%= form.label :email_address, t("passwords.new.email_label"), class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address], class: "input input-bordered w-full focus:input-primary transition-all duration-200" %>
        </div>

        <div class="form-control pt-2 space-y-2">
          <%= form.submit t("passwords.new.submit_button"), class: "btn btn-primary w-full shadow-md shadow-primary/20 font-bold" %>
          <%= link_to t("passwords.new.back_to_login"), new_session_path, class: "btn btn-ghost btn-sm w-full font-semibold" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
