<%= form_with model: transaction, class: "space-y-4" do |form| %>
  <% if transaction.errors.any? %>
    <div role="alert" class="alert alert-error shadow-sm mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <h3 class="font-bold text-sm"><%= t("transactions.form.errors_title") %></h3>
        <ul class="list-disc list-inside text-xs mt-1">
          <% transaction.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-control">
    <span class="label-text font-semibold text-xs mb-1.5 opacity-70"><%= t("transactions.form.classification") %></span>
    <div class="flex gap-4 p-2 bg-base-200/50 rounded-xl border border-base-200">
      <label class="label cursor-pointer flex-1 justify-center gap-2 bg-base-100 rounded-lg py-2 border border-base-300 hover:border-error/30 transition-all duration-200 shadow-sm">
        <%= form.radio_button :income, false, class: "radio radio-error radio-sm" %>
        <span class="label-text font-bold text-xs opacity-80 flex items-center gap-1">💸 <%= t("transactions.form.expense") %></span>
      </label>
      <label class="label cursor-pointer flex-1 justify-center gap-2 bg-base-100 rounded-lg py-2 border border-base-300 hover:border-success/30 transition-all duration-200 shadow-sm">
        <%= form.radio_button :income, true, class: "radio radio-success radio-sm" %>
        <span class="label-text font-bold text-xs opacity-80 flex items-center gap-1">💰 <%= t("transactions.form.income") %></span>
      </label>
    </div>
  </div>

  <div class="form-control">
    <%= form.label :purpose, t("transactions.form.purpose_label"), class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
    <%= form.text_field :purpose, autofocus: true, placeholder: t("transactions.form.purpose_placeholder"), class: "input input-bordered w-full focus:input-primary transition-all duration-200" %>
  </div>

  <div class="form-control" data-controller="amount-format" data-amount-format-separator-value=".">
    <%= form.label :total, t("transactions.form.amount_label"), class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
    <div class="relative">
      <%= form.hidden_field :total, data: { amount_format_target: "hidden" } %>
      <%= text_field_tag :formatted_total, nil,
                         placeholder: t("transactions.form.amount_placeholder"),
                         inputmode: "numeric",
                         class: "input input-bordered w-full pr-12 focus:input-primary transition-all duration-200",
                         data: { amount_format_target: "visible", action: "input->amount-format#formatInput" } %>
      <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-sm font-semibold opacity-50">
        ₫
      </div>
    </div>
  </div>

  <div class="form-control pt-2 flex flex-col sm:flex-row gap-2 justify-end">
    <%= link_to t("transactions.form.cancel"), transactions_path, class: "btn btn-ghost order-last sm:order-first" %>
    <%= form.submit t("transactions.form.submit"), class: "btn btn-primary shadow-md shadow-primary/20 font-bold px-6" %>
  </div>
<% end %>
