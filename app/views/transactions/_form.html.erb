<%= form_with model: transaction, class: "space-y-4" do |form| %>
  <% if transaction.errors.any? %>
    <div role="alert" class="alert alert-error shadow-sm mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <h3 class="font-bold text-sm">Vui lòng kiểm tra các lỗi sau:</h3>
        <ul class="list-disc list-inside text-xs mt-1">
          <% transaction.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-control">
    <%= form.label :purpose, class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
    <%= form.text_field :purpose, autofocus: true, placeholder: "Ví dụ: Ăn trưa, Đổ xăng, Mua sắm...", class: "input input-bordered w-full focus:input-primary transition-all duration-200" %>
  </div>

  <div class="form-control">
    <%= form.label :total, class: "label-text font-semibold text-xs mb-1.5 opacity-70" %>
    <div class="relative">
      <%= form.number_field :total, placeholder: "Nhập số tiền (VND)", min: 1, class: "input input-bordered w-full pr-12 focus:input-primary transition-all duration-200" %>
      <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-sm font-semibold opacity-50">
        ₫
      </div>
    </div>
  </div>

  <div class="form-control pt-2 flex flex-col sm:flex-row gap-2 justify-end">
    <%= link_to "Hủy", transactions_path, class: "btn btn-ghost order-last sm:order-first" %>
    <%= form.submit class: "btn btn-primary shadow-md shadow-primary/20 font-bold px-6" %>
  </div>
<% end %>
