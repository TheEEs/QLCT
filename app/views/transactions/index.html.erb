<div class="space-y-8 w-full animate-fade-in">
  <!-- Header with actions and stats -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-base-100 p-6 rounded-2xl border border-base-300 shadow-sm">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= t("transactions.index.title") %></h1>
      <p class="text-sm opacity-60">
        <%= raw t("transactions.index.greeting", count: "<span class=\"font-bold text-primary\">#{@pagy.count}</span>") %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to new_transaction_path, class: "btn btn-primary btn-sm md:btn-md gap-2 shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        <%= t("transactions.index.add_new") %>
      <% end %>
      <%= link_to t("transactions.index.home"), root_path, class: "btn btn-outline btn-sm md:btn-md" %>
    </div>
  </div>

  <!-- Summary Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Income Card -->
    <div class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow duration-200">
      <div class="card-body p-6 flex flex-row items-center justify-between">
        <div class="space-y-1">
          <span class="text-sm font-semibold opacity-60"><%= t("transactions.index.income_title") %></span>
          <h2 class="text-2xl font-extrabold tracking-tight text-success">
            <%= number_to_currency(@total_income, unit: "₫", precision: 0, format: "%n %u") %>
          </h2>
        </div>
        <div class="p-3 bg-success/10 rounded-xl text-success">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Expense Card -->
    <div class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow duration-200">
      <div class="card-body p-6 flex flex-row items-center justify-between">
        <div class="space-y-1">
          <span class="text-sm font-semibold opacity-60"><%= t("transactions.index.expense_title") %></span>
          <h2 class="text-2xl font-extrabold tracking-tight text-error">
            <%= number_to_currency(@total_expense, unit: "₫", precision: 0, format: "%n %u") %>
          </h2>
        </div>
        <div class="p-3 bg-error/10 rounded-xl text-error">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Balance Card -->
    <div class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow duration-200">
      <div class="card-body p-6 flex flex-row items-center justify-between">
        <div class="space-y-1">
          <span class="text-sm font-semibold opacity-60"><%= t("transactions.index.balance_title") %></span>
          <h2 class="text-2xl font-extrabold tracking-tight <%= @balance >= 0 ? 'text-primary' : 'text-warning' %>">
            <%= @balance >= 0 ? "+" : "" %><%= number_to_currency(@balance, unit: "₫", precision: 0, format: "%n %u") %>
          </h2>
        </div>
        <div class="p-3 <%= @balance >= 0 ? 'bg-primary/10 text-primary' : 'bg-warning/10 text-warning' %> rounded-xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Transactions Table Card -->
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <%= turbo_frame_tag "transactions_frame" do %>
      <div class="card-body p-6">
        <% if @transactions.any? %>
          <%
            sort_options = {
              "created_at_desc" => t("transactions.sort.date_desc"),
              "created_at_asc" => t("transactions.sort.date_asc"),
              "total_desc" => t("transactions.sort.total_desc"),
              "total_asc" => t("transactions.sort.total_asc")
            }
            current_sort_key = "#{params[:sort] || 'created_at'}_#{params[:direction] || 'desc'}"
            current_sort_label = sort_options[current_sort_key] || sort_options["created_at_desc"]
          %>
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
            <h2 class="text-lg font-bold"><%= t("transactions.index.history_title") %></h2>
            <div class="flex flex-wrap items-center gap-4 self-end lg:self-auto">
              <!-- Items per page dropdown -->
              <div class="flex items-center gap-2">
                <span class="text-xs opacity-60 font-semibold"><%= t("transactions.index.show_limit") %></span>
                <div class="dropdown dropdown-end">
                  <div tabindex="0" role="button" class="btn btn-outline btn-xs gap-1 py-1 px-2.5 h-auto min-h-0 font-bold transition-all duration-200">
                    <%= t("transactions.index.rows", count: @pagy.limit) %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                  <ul tabindex="0" class="dropdown-content menu menu-sm p-2 shadow-xl bg-base-100 rounded-box w-32 border border-base-200 z-[1] mt-1">
                    <% [5, 10, 20, 50, 100].each do |count| %>
                      <li>
                        <%= link_to t("transactions.index.rows", count: count), transactions_path(sort: params[:sort], direction: params[:direction], items: count), class: "#{'active font-bold' if @pagy.limit == count}" %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </div>

              <!-- Sort dropdown -->
              <div class="flex items-center gap-2">
                <span class="text-xs opacity-60 font-semibold"><%= t("transactions.sort.label") %></span>
                <div class="dropdown dropdown-end">
                  <div tabindex="0" role="button" class="btn btn-outline btn-xs gap-1 py-1 px-2.5 h-auto min-h-0 font-bold transition-all duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
                    </svg>
                    <%= current_sort_label %>
                  </div>
                  <ul tabindex="0" class="dropdown-content menu menu-sm p-2 shadow-xl bg-base-100 rounded-box w-52 border border-base-200 z-[1] mt-1">
                    <li><%= link_to t("transactions.sort.date_desc"), transactions_path(sort: "created_at", direction: "desc", items: @pagy.limit, page: params[:page]), class: "#{'active font-bold' if current_sort_key == 'created_at_desc'}" %></li>
                    <li><%= link_to t("transactions.sort.date_asc"), transactions_path(sort: "created_at", direction: "asc", items: @pagy.limit, page: params[:page]), class: "#{'active font-bold' if current_sort_key == 'created_at_asc'}" %></li>
                    <div class="divider my-1"></div>
                    <li><%= link_to t("transactions.sort.total_desc"), transactions_path(sort: "total", direction: "desc", items: @pagy.limit, page: params[:page]), class: "#{'active font-bold' if current_sort_key == 'total_desc'}" %></li>
                    <li><%= link_to t("transactions.sort.total_asc"), transactions_path(sort: "total", direction: "asc", items: @pagy.limit, page: params[:page]), class: "#{'active font-bold' if current_sort_key == 'total_asc'}" %></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="table table-md w-full">
              <thead>
                <tr>
                  <th><%= t("transactions.index.table.purpose") %></th>
                  <th><%= t("transactions.index.table.time") %></th>
                  <th class="text-right"><%= t("transactions.index.table.amount") %></th>
                  <th class="text-center"><%= t("transactions.index.table.actions") %></th>
                </tr>
              </thead>
              <tbody>
                <% @transactions.each do |transaction| %>
                  <tr class="hover:bg-base-200/40 transition-colors duration-150">
                    <td class="font-bold py-4">
                      <div class="flex items-center gap-2">
                        <span class="text-lg"><%= transaction.income? ? "💰" : "💸" %></span>
                        <span><%= transaction.purpose %></span>
                        <% if transaction.income? %>
                          <span class="badge badge-success badge-xs font-bold text-[10px] text-success-content px-1.5 py-0.5 h-auto min-h-0"><%= t("transactions.index.table.income_badge") %></span>
                        <% end %>
                      </div>
                    </td>
                    <td class="text-sm opacity-70">
                      <%= l(transaction.created_at, format: :long) rescue transaction.created_at.strftime("%H:%M - %d/%m/%Y") %>
                    </td>
                    <td class="text-right font-black text-md <%= transaction.income? ? 'text-success' : 'text-error' %>">
                      <%= transaction.income? ? "+" : "-" %><%= number_to_currency(transaction.total, unit: "₫", precision: 0, format: "%n %u") %>
                    </td>
                    <td class="text-center py-4">
                      <div class="flex items-center justify-center gap-2">
                        <%= link_to edit_transaction_path(transaction), data: { turbo_frame: "_top" }, class: "btn btn-ghost btn-xs text-primary font-bold hover:bg-primary/10" do %>
                          <%= t("transactions.index.table.edit") %>
                        <% end %>
                        <%= button_to transaction_path(transaction), method: :delete, data: { turbo_confirm: t("transactions.index.table.delete_confirm"), turbo_frame: "_top" }, class: "btn btn-ghost btn-xs text-error font-bold hover:bg-error/10" do %>
                          <%= t("transactions.index.table.delete") %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- Pagination Footer with showing X to Y of Z status -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-6 pt-6 border-t border-base-200">
            <div class="text-sm opacity-70">
              <%= raw t("transactions.index.showing", 
                        from: "<span class=\"font-bold text-base-content\">#{@pagy.from}</span>", 
                        to: "<span class=\"font-bold text-base-content\">#{@pagy.to}</span>", 
                        count: "<span class=\"font-bold text-primary\">#{@pagy.count}</span>") %>
            </div>

            <% if @pagy.pages > 1 %>
              <div class="flex justify-center">
                <%== @pagy.series_nav %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12 space-y-4">
            <div class="text-5xl">🛍️</div>
            <h3 class="text-lg font-bold"><%= t("transactions.index.no_transactions") %></h3>
            <p class="text-sm opacity-60 max-w-sm mx-auto">
              <%= t("transactions.index.no_transactions_desc") %>
            </p>
            <%= link_to new_transaction_path, class: "btn btn-primary btn-sm gap-2" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              <%= t("transactions.index.add_now") %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
